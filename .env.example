# SatQuery AI — Environment Configuration
# Copy to .env and edit values as needed. Never commit .env to Git.

# ── Application ──────────────────────────────────────────────────
DEBUG=true
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Upload limits ────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_IMAGE_DIMENSION=10000
MIN_IMAGE_DIMENSION=16

# ── Storage ──────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
EVIDENCE_DIR=evidence_outputs

# ── Models ───────────────────────────────────────────────────────
USE_MOCK_MODELS=true
MODEL_DEVICE=cpu

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
